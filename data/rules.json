{
  "rules": {
    "/periodico": {
      ".read": true,
      ".write": false,
      "onViolation": {
        "action": "redirect",
        "target": "/login",
        "message": "Debes iniciar sesión para escribir en el periódico"
      }
    },
    "/dashboard": {
      ".read": "auth != null",
      ".write": "auth.rol == 'admin'",
      "onViolation": {
        "action": "redirect",
        "target": "/login",
        "message": "Acceso denegado. Inicia sesión."
      }
    },
    "/admin": {
      ".read": "auth.rol == 'admin'",
      ".write": "auth.rol == 'admin'",
      "onViolation": {
        "action": "block",
        "target": "/403",
        "message": "Necesitas permisos de administrador"
      }
    },
    "/api/delete": {
      ".write": "auth.rol == 'admin'",
      "onViolation": {
        "action": "log",
        "target": "/logs/violations.json",
        "message": "Intento de eliminación no autorizado"
      }
    }
  },
  "defaultOnViolation": {
    "action": "toast",
    "message": "No tienes permiso para realizar esta acción"
  }
}